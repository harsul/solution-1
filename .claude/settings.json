{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet test)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(npm run lint *)",
      "Bash(npm run lint)",
      "Bash(npm run build *)",
      "Bash(npm run build)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git rev-parse *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Skill(simplify)",
      "Skill(simplify *)",
      "Skill(code-review)",
      "Skill(code-review *)",
      "Skill(security-review)",
      "Bash(npm --prefix src/frontend run lint)",
      "Bash(npm --prefix src/frontend run build)",
      "Bash(npm --prefix src/frontend test)",
      "Bash(npm --prefix src/frontend run test *)",
      "Bash(npm --prefix src/frontend run format*)",
      "Bash(dotnet format *)",
      "Bash(git fetch *)",
      "Bash(.claude/scripts/fgit.sh *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "Bash(npm uninstall *)",
      "Bash(dotnet add *)",
      "Bash(dotnet remove *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git commit --no-verify *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets.json)"
    ]
  }
}
