{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet test)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(npm run lint *)",
      "Bash(npm run lint)",
      "Bash(npm run build *)",
      "Bash(npm run build)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git rev-parse *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Skill(simplify)",
      "Skill(simplify *)",
      "Skill(code-review)",
      "Skill(code-review *)",
      "Skill(security-review)",
      "Bash(npm --prefix src/frontend run lint)",
      "Bash(npm --prefix src/frontend run build)",
      "Bash(npm --prefix src/frontend test)",
      "Bash(npm --prefix src/frontend run test *)",
      "Bash(npm --prefix src/frontend run format*)",
      "Bash(dotnet format *)",
      "Bash(git fetch *)",
      "Bash(git rebase origin/*)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(.claude/scripts/work.sh *)",
      "Bash(bash .claude/scripts/work.sh *)",
      "Bash(gh pr *)",
      "Bash(gh run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git stash *)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "Bash(npm uninstall *)",
      "Bash(dotnet add *)",
      "Bash(dotnet remove *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git commit --no-verify *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"", "timeout": 30 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"", "timeout": 30 }]
      }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.sh\"", "timeout": 1800 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\"", "timeout": 10 }] }
    ]
  }
}
